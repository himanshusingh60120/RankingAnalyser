# .env.example
# ===== Google Search Console OAuth (Web application client) =====
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://ranking-analyser.vercel.app/api/auth/callback
OAUTH_STATE_SECRET=any-long-random-string-32-chars-plus

# ===== AI recommendations (ChatGPT API) =====
OPENAI_API_KEY=sk-...
# optional, defaults to gpt-4o-mini:
OPENAI_MODEL=gpt-4o-mini
# NEW (optional): separate model for the Content Brief writer — falls back to OPENAI_MODEL
OPENAI_BRIEF_MODEL=

# ===== GSC auto-connect (so the tool always pulls Search Console data) =====
# Get the refresh token once from https://your-app.vercel.app/api/auth/start
GSC_REFRESH_TOKEN=
GSC_SITE_URL=https://www.kingsresearch.com/

# ===== NEW: live Google results — Content Brief (/brief) + competitor auto-find =====
# Set ONE of these. Serper.dev is recommended — https://serper.dev
SERPER_API_KEY=
# OR SerpApi (also returns AI Overview sources) — https://serpapi.com
SERPAPI_KEY=
# Default Google country / language for briefs (the /brief page can override per run)
SERP_DEFAULT_GL=us
SERP_DEFAULT_HL=en
# Your domain, so briefs can spot your own ranking page (falls back to GSC_SITE_URL's domain)
OUR_DOMAIN=kingsresearch.com

# ===== Optional: competitor auto-find via a search provider (LEGACY) =====
# Google Programmable Search Engine — closed to new customers; Google switches it off on 1 Jan 2027.
# Still used automatically as a fallback when neither SERPER_API_KEY nor SERPAPI_KEY is set.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# OR Bing Web Search — RETIRED by Microsoft on 11 Aug 2025. The code no longer reads this; kept for reference only.
BING_SEARCH_KEY=
