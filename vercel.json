{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/plan.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/hreflang-report.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/crawl/ingest.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/crawl/jobs.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/crawl/next.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/crawl/status.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/bulk-compare.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/sitemaps.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
