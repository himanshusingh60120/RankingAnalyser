# agent/.env.example  — copy to agent/.env and fill in

# Your deployed Vercel app (no trailing slash)
VERCEL_BASE_URL=https://ranking-analyser.vercel.app

# Shared secret. Must EXACTLY match the AGENT_TOKEN env var set in Vercel.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=paste-the-same-long-random-string-here

# Full path to the Screaming Frog CLI executable:
#   Windows: C:\Program Files\Screaming Frog SEO Spider\ScreamingFrogSEOSpiderCli.exe
#   macOS:   /Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpider
#   Linux:   screamingfrogseospider
SF_CLI_PATH=C:\Program Files\Screaming Frog SEO Spider\ScreamingFrogSEOSpiderCli.exe

# Optional: a saved .seospiderconfig (make one in the desktop app, File > Save Configuration).
# Enable Google Search Console > URL Inspection inside that config if you want Google's
# actual verdict in the "Coverage" column (still bound by Google's 2,000/day).
SF_CONFIG_PATH=

# Optional: fixed output folder. If empty, a temp folder is used per crawl.
SF_OUTPUT_DIR=

# How many URLs per upload chunk, and poll interval when using --loop
CHUNK_SIZE=4000
POLL_SECONDS=60
